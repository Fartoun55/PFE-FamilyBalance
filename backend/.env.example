NODE_ENV=development
# 5001 : port vers lequel le proxy Angular (frontend/proxy.conf.json) relaie /api et /socket.io
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/familybalance
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ADMIN_REGISTRATION_KEY=change-me-admin-registration-key
# Clé de chiffrement des messages de téléconsultation (AES-256-GCM)
TELECONSULTATION_SECRET=change-me-teleconsultation-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:4200
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_FROM="FamilyBalance <no-reply@example.com>"
