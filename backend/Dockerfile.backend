# Image de l'API FamilyBalance (Node.js / Express / Socket.IO)
# Construction : docker build -f backend/Dockerfile.backend -t familybalance-backend backend
FROM node:20-alpine

WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000

# Dépendances d'abord (cache Docker), sans les dépendances de développement
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Code source (le .dockerignore exclut .env, node_modules et uploads)
COPY --chown=node:node . .

# Dossier des fichiers téléversés (ressources éducatives) : doit appartenir à
# l'utilisateur non-root, sinon l'upload échoue. En production il est monté sur
# un volume persistant (voir k8s/deployment.yml).
RUN mkdir -p uploads/education && chown -R node:node uploads

# UID numérique (= utilisateur « node ») : vérifiable par runAsNonRoot dans Kubernetes
USER 1000:1000

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["sh", "-c", "wget -q -O /dev/null http://127.0.0.1:${PORT}/health || exit 1"]

# node directement (et non « npm start ») : reçoit SIGTERM et s'arrête proprement.
CMD ["node", "src/server.js"]
