@startuml comptes-evaluation
!include ../_style.iuml
title Diagramme de classes — Comptes, familles et évaluation
hide empty methods

class User {
  - _id : ObjectId
  + firstName : String
  + lastName : String
  + email : String {unique}
  - passwordHash : String
  + role : Role
  + phone : String [0..1]
  + avatarUrl : String [0..1]
  + isActive : Boolean = true
  + emailVerified : Boolean = false
  + mfaEnabled : Boolean = false
  + passwordChangedAt : Date [0..1]
  + lastLoginAt : Date [0..1]
  --
  + comparePassword(password : String) : Boolean
  + toSafeJSON() : Object
}

class SpecialistInfo <<sous-document>> {
  + specialization : String
  + licenseNumber : String
  + city : String
  + tariff : Number {>= 0}
  + languages : String[*]
}

class AdolescentInfo <<sous-document>> {
  + birthDate : Date
  + ageSegment : String
  + consentGiven : Boolean
  + consentAt : Date
  --
  {âge 3 à 18 ans}
}

class SurveyQuestion {
  + code : String {unique}
  + domain : String
  + domainLabel : String
  + ageSegments : String[*]
  + order : Number
  + type : QuestionType
  + prompt : String
  + helpText : String [0..1]
  + defaultNextCode : String [0..1]
  + isEntryPoint : Boolean
  + active : Boolean
}

class SurveyOption <<sous-document>> {
  + label : String
  + value : String
}

class BranchRule <<sous-document>> {
  + values : String[*]
  + minValue : Number [0..1]
  + maxValue : Number [0..1]
  + nextCode : String
}

class SurveySession {
  + domain : String
  + domainLabel : String
  + age : Number
  + ageSegment : String
  + status : SessionStatus
  + currentQuestionCode : String [0..1]
  + startedAt : Date
  + lastSavedAt : Date
  + completedAt : Date [0..1]
  --
  {une seule session in-progress
   par (user, domain, ageSegment)}
}

class SurveyAnswer <<sous-document>> {
  + questionCode : String
  + questionPrompt : String
  + domain : String
  + type : String
  + answer : Mixed
  + draft : Boolean
  + answeredAt : Date
}

class ScoreRecord {
  + age : Number {3..18}
  + ageSegment : String
  + globalScore : Number {0..100}
  + riskLevel : RiskLevel
  + riskCategory : RiskCategory
  + recommendations : String[*]
  + answerCount : Number
  + trigger : ScoreTrigger
  + calculatedAt : Date
  --
  {sourceSession unique : un score par session}
}

class SubScores <<sous-document>> {
  + comportemental : Number {0..100}
  + emotionnel : Number {0..100}
  + social : Number {0..100}
  + parental : Number {0..100}
}

class RiskAlert {
  + level : "red"
  + riskCategory : RiskCategory
  + status : AlertStatus
  + message : String
  + resolvedAt : Date [0..1]
  --
  {au plus une alerte open par utilisateur}
}

User *-- "0..1" SpecialistInfo : specialistProfile
User *-- "0..1" AdolescentInfo : adolescentProfile
AdolescentInfo "0..*" --> "1" User : parentId\n« parent »

User "1" -- "0..*" SurveySession : répond à >
SurveySession *-- "0..*" SurveyAnswer : answers
SurveyAnswer ..> SurveyQuestion : questionCode
SurveyQuestion *-- "0..*" SurveyOption : options
SurveyQuestion *-- "0..*" BranchRule : branchingRules

SurveySession "1" -- "0..1" ScoreRecord : sourceSession <
User "1" -- "0..*" ScoreRecord : user <
ScoreRecord *-- "2" SubScores : subScores, weights
ScoreRecord "1" -- "0..*" RiskAlert : déclenche >
User "1" -- "0..*" RiskAlert : concerne <
@enduml
