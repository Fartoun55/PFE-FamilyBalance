@startuml education
!include ../_style.iuml
title Diagramme de classes — Éducation et accompagnement parental
hide empty methods

class User {
  + firstName : String
  + lastName : String
  + role : Role
}

class EducationalResource {
  + title : String
  + description : String
  + category : String
  + ageMin : Number {3..18}
  + ageMax : Number {3..18}
  + contentType : ContentType
  + fileUrl : String [0..1]
  + externalUrl : String [0..1]
  + themes : String[*]
  + estimatedMinutes : Number {1..240}
  + difficulty : Difficulty
  + status : ResourceStatus
  + publishedAt : Date [0..1]
  --
  + contentUrl() : String <<virtuel>>
  --
  {ageMin <= ageMax ; fichier requis pour
   image/pdf, URL requise pour vidéo/lien}
}

class LearningProgress {
  + pathId : String
  + completedStepIds : String[*]
  + badges : String[*]
  + progressPercent : Number {0..100}
  + lastCompletedAt : Date
  --
  {unique (user, pathId)}
}

class ParentToolkitItem {
  + itemType : ToolkitItemType
  + title : String
  + content : String
  + activities : String[*]
  + startDate : Date [0..1]
  + endDate : Date [0..1]
}

class NewsletterDigest {
  + subject : String
  + profileInsights : String[*]
  + scoreInsights : String[*]
  + recommendations : String[*]
}

User "0..1" -- "0..*" EducationalResource : createdBy (admin) <
User "1" -- "0..*" LearningProgress : user <
User "1" -- "0..*" ParentToolkitItem : parent <
User "1" -- "0..*" NewsletterDigest : user <
@enduml
