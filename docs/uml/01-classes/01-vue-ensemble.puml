@startuml vue-ensemble
!include ../_style.iuml
title Diagramme de classes — Vue d'ensemble du modèle de domaine\n(17 entités MongoDB, relations et multiplicités)
hide members
hide circle
left to right direction


package "Comptes et sécurité" {
  class User
  class SpecialistInfo <<sous-document>>
  class AdolescentInfo <<sous-document>>
  class RefreshToken
  class MfaChallenge
  class EmailVerificationToken
  class PasswordResetToken
}

package "Évaluation" {
  class SurveyQuestion
  class SurveySession
  class ScoreRecord
  class RiskAlert
}

package "Téléconsultation" {
  class TeleconsultationSpecialistProfile
  class TeleconsultationAppointment
  class TeleconsultationMessage
}

package "Éducation" {
  class EducationalResource
  class LearningProgress
  class ParentToolkitItem
  class NewsletterDigest
}

package "Notifications" {
  class Notification
}

User *-- "0..1" SpecialistInfo
User *-- "0..1" AdolescentInfo
AdolescentInfo "0..*" --> "1" User : parent

User -- "0..*" RefreshToken
User -- "0..*" MfaChallenge
User -- "0..*" EmailVerificationToken
User -- "0..*" PasswordResetToken

User -- "0..*" SurveySession
SurveySession ..> SurveyQuestion : questionCode
SurveySession "1" -- "0..1" ScoreRecord
User -- "0..*" ScoreRecord
ScoreRecord "1" -- "0..*" RiskAlert
User -- "0..*" RiskAlert

User "0..1" -- "0..1" TeleconsultationSpecialistProfile : linkedUser
TeleconsultationSpecialistProfile "1" -- "0..*" TeleconsultationAppointment
User -- "0..*" TeleconsultationAppointment : patient
TeleconsultationAppointment "1" o-- "0..*" TeleconsultationMessage
User -- "0..*" TeleconsultationMessage : sender / recipient

User -- "0..*" EducationalResource : createdBy
User -- "0..*" LearningProgress
User -- "0..*" ParentToolkitItem
User -- "0..*" NewsletterDigest
User -- "0..*" Notification
legend bottom right
  Multiplicité côté User : 1 (sauf createdBy : 0..1, linkedUser : 0..1).
  Losange plein : composition (sous-document) ; losange vide : agrégation ;
  flèche pointillée : dépendance (référence par code de question).
endlegend
@enduml
