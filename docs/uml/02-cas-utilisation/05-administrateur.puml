@startuml cu-administrateur
!include ../_style.iuml
title Diagramme de cas d'utilisation — Administrateur
left to right direction

actor "Administrateur" as Admin

rectangle "FamilyBalance — Administration" {
  package "Comptes utilisateurs" {
    usecase "Consulter et rechercher\nles comptes" as ListAcc
    usecase "Créer un compte" as CreateAcc
    usecase "Modifier un compte" as UpdateAcc
    usecase "Activer / désactiver\nun compte" as StatusAcc
    usecase "Supprimer un compte" as DeleteAcc
    usecase "Exporter les comptes\n(Excel, Word, PDF)" as Export
    usecase "Exporter les données\nanonymisées" as ExportAnon
  }
  package "Spécialistes" {
    usecase "Consulter la liste\ndes spécialistes" as ListSpe
    usecase "Rechercher / filtrer\n(statut, ville, spécialité)" as FilterSpe
    usecase "Consulter le détail\nd'un spécialiste" as DetailSpe
    usecase "Ajouter un\nspécialiste" as CreateSpe
    usecase "Modifier un spécialiste\n(profil, disponibilités)" as UpdateSpe
    usecase "Supprimer un\nspécialiste" as DeleteSpe
    usecase "Vérifier l'absence de\nrendez-vous à venir" as CheckAppt
    usecase "Désactiver le compte" as DeactivateSpe
  }
  package "Contenus éducatifs" {
    usecase "Gérer les ressources\n(ajouter, modifier, supprimer)" as ManageRes
    usecase "Publier / dépublier\nune ressource" as Publish
    usecase "Traiter la file\nde modération" as Moderation
  }
}

Admin --> ListAcc
Admin --> CreateAcc
Admin --> UpdateAcc
Admin --> StatusAcc
Admin --> DeleteAcc
Admin --> Export
Admin --> ListSpe
Admin --> CreateSpe
Admin --> UpdateSpe
Admin --> DeleteSpe
Admin --> ManageRes
Admin --> Moderation

ExportAnon .> Export : <<extend>>
FilterSpe .> ListSpe : <<extend>>
DetailSpe .> ListSpe : <<extend>>
DeleteSpe ..> CheckAppt : <<include>>
DeactivateSpe .> DeleteSpe : <<extend>>\n(rendez-vous à venir)
DeleteAcc ..> CheckAppt : <<include>>\n(compte spécialiste)
Moderation ..> Publish : <<include>>
Publish .> ManageRes : <<extend>>

@enduml
