@startuml cu-authentification-compte
!include ../_style.iuml
title Diagramme de cas d'utilisation — Authentification, compte et notifications
left to right direction

actor "Visiteur" as Visiteur
actor "Utilisateur\nauthentifié" as Auth
actor "Service e-mail\n(SMTP)" as Mail <<système>>

rectangle "FamilyBalance — Compte" {
  usecase "S'inscrire\n(parent, spécialiste\nou administrateur)" as Register
  usecase "Confirmer son\nadresse e-mail" as Verify
  usecase "Fournir la clé\nd'inscription admin" as AdminKey
  usecase "Se connecter" as Login
  usecase "Vérifier le code\nMFA (2 étapes)" as Mfa
  usecase "Réinitialiser son\nmot de passe" as Reset
  usecase "Consulter et modifier\nson profil" as Profile
  usecase "Changer son\nmot de passe" as ChangePwd
  usecase "Se déconnecter" as Logout
  usecase "Consulter ses\nnotifications" as Notif
  usecase "Marquer comme lue(s)" as NotifRead
  usecase "Supprimer une\nnotification" as NotifDelete
  usecase "Ouvrir l'élément\nconcerné" as NotifOpen
  usecase "Recevoir une notification\nen temps réel" as NotifRealtime
}

Visiteur --> Register
Visiteur --> Verify
Visiteur --> Login
Visiteur --> Reset
Auth --> Profile
Auth --> Logout
Auth --> Notif

Register ..> Verify : <<include>>
AdminKey .> Register : <<extend>>\n(rôle administrateur)
Mfa .> Login : <<extend>>\n(compte avec MFA activé)
Profile <.. ChangePwd : <<extend>>
NotifRead .> Notif : <<extend>>
NotifDelete .> Notif : <<extend>>
NotifOpen .> Notif : <<extend>>
Notif <.. NotifRealtime : <<extend>>

Register --> Mail
Mfa --> Mail
Reset --> Mail

note right of Register
  Un adolescent ne s'inscrit pas lui-même :
  son compte est créé par son parent.
end note
@enduml
