@startuml seq-traitement-demande
!include ../_style.iuml
title Diagramme de séquence — Réception et traitement d'une demande de téléconsultation (spécialiste)
autonumber "<b>[0]"
skinparam maxMessageSize 230

actor "Spécialiste" as S
box "Frontend Angular" #F7F9FD
  participant "NotificationBell /\nNotificationService" as Bell
  participant "Teleconsultation\nPage" as Page
end box
box "Backend Node.js / Express" #FFFBEB
  participant "Socket.IO\n(realtime)" as WS
  participant "Teleconsultation\nController / Service" as Svc
  participant "Notification\nService" as Notif
end box
database "MongoDB" as DB
actor "Patient\n(parent / adolescent)" as P

== Réception de la demande (après la réservation du patient) ==
Notif -> DB : Notification(type: appointment-requested, user: spécialiste)
Notif -> WS : emitToUser(spécialiste, 'notification:new')
WS ->> Bell : notification:new { notification, unreadCount }
Bell --> S : badge de la cloche incrémenté (sans rechargement)
S -> Bell : ouvre la notification
Bell -> Svc : PATCH /api/notifications/:id/read
Bell -> Page : navigate('/teleconsultation?appointment=:id')

== Consultation des demandes ==
Page -> Svc : GET /api/teleconsultation/dashboard\n(authorizeRoles('specialist'))
Svc -> DB : ensureSpecialistProfileForUser()
Svc -> DB : rendez-vous où specialistUser = moi\nou specialistProfile = ma fiche
Svc -> DB : patients (nom, e-mail, rôle uniquement),\nderniers scores, alertes ouvertes
Svc --> Page : { appointments, patients }
Page -> Page : ouvre la demande ciblée par le paramètre « appointment »
Page --> S : demandeur, rôle, créneau, motif, mode, statut
opt bilan partagé par le patient
  Page --> S : score global, niveau de risque, sous-scores
end

== Traitement ==
alt annulation
  S -> Page : « Annuler le rendez-vous »
  Page -> Svc : PATCH /appointments/:id/cancel
  Svc -> DB : getAppointmentByIdForUser() — contrôle d'accès
  alt ni patient ni spécialiste du rendez-vous
    Svc --> Page : 403 « Accès refusé à ce rendez-vous »
  else rendez-vous terminé ou déjà annulé
    Svc --> Page : 400
  else
    Svc -> DB : status = cancelled
    Svc -> Notif : notifyAppointmentChanged(appt, spécialiste, 'cancelled')
    Notif -> DB : Notification « Rendez-vous annulé » (patient)
    Notif -> WS : emitToUser(patient)
    WS ->> P : notification:new
    Svc --> Page : 200 ; liste rechargée via /dashboard
  end
else déplacement
  S -> Page : nouveau créneau
  Page -> Svc : PATCH /appointments/:id/reschedule
  Svc -> DB : contrôle d'accès + chevauchement
  alt créneau pris
    Svc --> Page : 409
  else
    Svc -> DB : slotStart, slotEnd mis à jour
    Svc -> Notif : notifyAppointmentChanged(appt, spécialiste, 'rescheduled')
    Notif -> WS : emitToUser(patient)
    WS ->> P : notification:new « Rendez-vous déplacé »
    Svc --> Page : 200
  end
else consultation
  S -> Page : « Rejoindre la visioconférence »
  Page --> S : ouverture de meetingUrl (Jitsi)
end
@enduml
