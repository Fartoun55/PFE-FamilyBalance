@startuml seq-prise-rendez-vous
!include ../_style.iuml
title Diagramme de séquence — Prise de rendez-vous avec un spécialiste (parent ou adolescent)
autonumber "<b>[0]"
skinparam maxMessageSize 230

actor "Parent /\nAdolescent" as P
box "Frontend Angular" #F7F9FD
  participant "Teleconsultation\nPage" as Page
  participant "Teleconsultation\nService (frontend)" as FSvc
end box
box "Backend Node.js / Express" #FFFBEB
  participant "Teleconsultation\nController" as Ctrl
  participant "Teleconsultation\nService" as Svc
  participant "Notification\nService" as Notif
end box
database "MongoDB" as DB

P -> Page : ouvre « Spécialistes »
Page -> FSvc : getSpecialists(filtres)
FSvc -> Ctrl : GET /api/teleconsultation/specialists?speciality&city&maxTariff
Ctrl -> Svc : getDirectory(filters)
Svc -> DB : syncSpecialistProfiles() — fiche créée pour tout\nspécialiste actif, masquée s'il est désactivé
Svc -> DB : TeleconsultationSpecialistProfile.find({ isActive: true })
loop pour chaque fiche correspondant aux filtres
  Svc -> DB : rendez-vous actifs sur la période
  Svc -> Svc : generateAvailableSlots()\n(règles de disponibilité, hors créneaux pris et passés)
end
Svc --> Page : 200 spécialistes + prochains créneaux
P -> Page : sélectionne un spécialiste
Page -> FSvc : getSlots(profileId)
FSvc -> Ctrl : GET /specialists/:id/slots
Ctrl -> Svc : getSlotsForSpecialist(id)
Svc --> Page : créneaux disponibles
P -> Page : choisit un créneau, saisit le motif et le mode
Page -> FSvc : bookAppointment(payload)
FSvc -> Ctrl : POST /api/teleconsultation/appointments\n(authorizeRoles('parent','adolescent'))
Ctrl -> Svc : createAppointment(patient, payload)
Svc -> DB : TeleconsultationSpecialistProfile.findById()
alt spécialiste introuvable ou inactif
  Svc --> Page : 404
else créneau invalide ou dans le passé
  Svc --> Page : 400
else créneau déjà réservé (chevauchement)
  Svc --> Page : 409 « Ce créneau n'est plus disponible »
else créneau libre
  Svc -> DB : TeleconsultationAppointment.create(status: confirmed,\nroomSlug, meetingUrl Jitsi, secret chiffré)
  note right of DB
    Index unique partiel {specialistProfile, slotStart} :
    une réservation concurrente sur le même créneau
    échoue (E11000) et est traduite en 409.
  end note
  Svc -> Notif : notifyAppointmentCreated(appointment, patient)
  activate Notif
  Notif -> DB : Notification « Nouvelle demande » (spécialiste)\n+ « Rendez-vous confirmé » (patient)
  Notif ->> Notif : emitToUser() via Socket.IO
  deactivate Notif
  Svc --> Ctrl : rendez-vous
  Ctrl --> FSvc : 201 « Rendez-vous confirmé »
  FSvc --> Page : succès
  Page -> FSvc : myAppointments() + getSlots() (rafraîchissement)
  Page --> P : rendez-vous affiché, créneau retiré
end
@enduml
