@startuml seq-questionnaire
!include ../_style.iuml
title Diagramme de séquence — Consultation et soumission d'un questionnaire (avec calcul du score)
autonumber "<b>[0]"
skinparam maxMessageSize 230

actor "Parent /\nAdolescent" as P
box "Frontend Angular" #F7F9FD
  participant "DynamicSurvey\nPage" as Page
  participant "SurveyService\n(frontend)" as FSvc
end box
box "Backend Node.js / Express" #FFFBEB
  participant "SurveyController" as Ctrl
  participant "SurveyService" as Svc
  participant "ScoringService" as Score
  participant "Notification\nService" as Notif
end box
database "MongoDB" as DB

== Configuration ==
P -> Page : choisit le répondant et l'enfant concerné\n(parent : uniquement ses enfants rattachés)
Page -> FSvc : loadCatalog(age, childId)
FSvc -> Ctrl : GET /api/surveys/catalog?childId\n(authorizeRoles('parent','adolescent'))
Ctrl -> Svc : resolveSurveyActor(user, childId, age)
alt childId fourni par un compte non parent
  Svc --> Page : 403
else enfant introuvable ou non rattaché à ce parent
  Svc --> Page : 404
else
  Ctrl -> Svc : buildCatalog(ageSegment)
  Svc -> DB : SurveyQuestion.find(ageSegment, active)\n(questions initialisées automatiquement si absentes)
  Svc --> Page : domaines disponibles + nombre de questions
end
P -> Page : choisit un domaine d'évaluation
Page -> FSvc : startOrResumeSurvey({ domain, age, childId })
FSvc -> Ctrl : POST /api/surveys/sessions/start
Ctrl -> Svc : startOrResumeSurvey(...)
Svc -> DB : SurveySession.findOne(user, domain, ageSegment, in-progress)
alt session en cours trouvée
  Svc --> Page : session reprise à la question courante
else
  Svc -> DB : SurveySession.create(status: in-progress,\nquestion d'entrée)
  Svc --> Page : nouvelle session + première question
end

== Réponses (adaptatives) ==
loop tant que la session n'est pas terminée
  P -> Page : répond (choix unique, échelle de Likert ou texte libre)
  Page -> FSvc : saveAnswer(sessionId, { answer, advance: true })
  FSvc -> Ctrl : PATCH /api/surveys/sessions/:id/answers
  Ctrl -> Svc : saveSurveyAnswer(sessionId, actor, answer, advance)
  Svc -> DB : getSessionForActor() — propriétaire ou parent de l'enfant
  alt session introuvable
    Svc --> Page : 404
  else session déjà terminée
    Svc --> Page : 400
  else réponse vide ou invalide (ex. Likert hors 1–5)
    Svc --> Page : 400
  else réponse valide
    Svc -> Svc : resolveNextQuestionCode()\n(règles de branchement selon la réponse)
    Svc -> DB : session.save() — contrôle de concurrence optimiste
    alt modification concurrente persistante
      Svc --> Page : 409 « Veuillez réessayer »
    else plus de question suivante
      Svc -> DB : status = completed, completedAt = now
      Svc --> Page : { completed: true }
    else question suivante
      Svc --> Page : { currentQuestion, progress }
      Page --> P : question suivante affichée
    end
  end
end

== Soumission et calcul du score ==
Page -> FSvc : completeSession(sessionId)
FSvc -> Ctrl : POST /api/surveys/sessions/:id/complete
Ctrl -> Svc : completeSurvey(sessionId, actor)
Svc -> DB : session finalisée
Ctrl -> Score : calculateAndStoreScore(actor, sessionId, 'auto')
Score -> Score : sous-scores (comportemental, émotionnel, social,\nparental), pondération par tranche d'âge,\nscore global 0–100, niveau et catégorie de risque
Score -> DB : ScoreRecord upsert (sourceSession unique)
alt niveau de risque rouge
  Score -> DB : RiskAlert « open » (une seule par utilisateur)
else
  Score -> DB : alertes ouvertes résolues
end
Score -> Notif : notifyScoreStored(score, alert, actor)
Notif -> DB : « Nouveau résultat » pour l'adolescent et/ou le parent\n(sauf l'auteur) ; alerte de risque : parent uniquement
Score --> Ctrl : { scoreRecord, alert }
Ctrl --> Page : 200 « Survey complété, scoring calculé »
Page --> P : synthèse des réponses + accès au résultat
@enduml
