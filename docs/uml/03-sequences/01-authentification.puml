@startuml seq-authentification
!include ../_style.iuml
title Diagramme de séquence — Authentification (mot de passe + vérification MFA)
autonumber "<b>[0]"
skinparam maxMessageSize 220

actor "Utilisateur" as U
box "Frontend Angular" #F7F9FD
  participant "LoginPage /\nMfaVerifyPage" as Page
  participant "AuthService\n(frontend)" as FAuth
end box
box "Backend Node.js / Express" #FFFBEB
  participant "AuthController" as Ctrl
  participant "AuthService\n(backend)" as BAuth
  participant "MailService" as Mail
end box
database "MongoDB" as DB

U -> Page : saisit e-mail et mot de passe
Page -> FAuth : login(email, password)
FAuth -> Ctrl : POST /api/auth/login
Ctrl -> Ctrl : validateLoginInput()
Ctrl -> BAuth : loginUser(email, password, meta)
BAuth -> DB : User.findOne({ email }) + passwordHash
DB --> BAuth : user | null

alt utilisateur introuvable
  BAuth --> Ctrl : AppError 401 « Identifiants invalides »
  Ctrl --> Page : 401
  Page --> U : message d'erreur
else compte inactif
  BAuth --> Ctrl : AppError 403 (e-mail non confirmé\nou compte désactivé)
  Ctrl --> Page : 403
  Page --> U : message d'erreur
else mot de passe incorrect (bcrypt)
  BAuth --> Ctrl : AppError 401 « Identifiants invalides »
  Ctrl --> Page : 401
  Page --> U : message d'erreur
else identifiants valides et MFA activé
  BAuth -> DB : MfaChallenge.create(tokenHash, codeHash, expiresAt)
  BAuth -> Mail : sendMfaCodeEmail(code à 6 chiffres)
  BAuth --> Ctrl : { requiresMfa: true, mfaToken, maskedEmail }
  Ctrl --> FAuth : 200 { requiresMfa, mfaToken }
  FAuth --> Page : réponse
  Page -> Page : navigate('/auth/mfa?token=…')
  U -> Page : saisit le code reçu par e-mail
  Page -> FAuth : verifyMfa(token, code)
  FAuth -> Ctrl : POST /api/auth/verify-mfa
  Ctrl -> BAuth : verifyMfaChallenge(token, code)
  BAuth -> DB : MfaChallenge.findOne({ tokenHash })
  alt défi absent, utilisé ou expiré
    BAuth --> Ctrl : AppError 400
    Ctrl --> Page : 400 « Code MFA invalide / expiré »
  else code incorrect
    BAuth -> DB : attempts + 1 (défi invalidé à 5 essais)
    BAuth --> Ctrl : AppError 400
    Ctrl --> Page : 400 « Code MFA invalide »
  else code correct
    BAuth -> DB : challenge.usedAt = now ; user.lastLoginAt = now
    BAuth -> BAuth : issueTokens() — JWT d'accès + jeton de rafraîchissement
    BAuth -> DB : RefreshToken.create(tokenHash, expiresAt, ip, userAgent)
    BAuth --> Ctrl : { user, accessToken, refreshToken }
    Ctrl --> FAuth : 200 { user, accessToken }\n+ cookie httpOnly refreshToken
    FAuth -> FAuth : setSession() — jeton en sessionStorage
    FAuth --> Page : utilisateur connecté
    Page --> U : redirection vers l'espace (/auth/profile)
  end
else identifiants valides sans MFA
  BAuth -> BAuth : issueTokens()
  BAuth -> DB : RefreshToken.create(...)
  Ctrl --> FAuth : 200 { user, accessToken } + cookie refreshToken
  Page --> U : redirection vers l'espace
end

note over FAuth, Ctrl
  Requêtes suivantes : l'intercepteur HTTP ajoute « Authorization: Bearer »,
  et le middleware protect() vérifie le JWT puis charge l'utilisateur actif.
  À expiration, POST /api/auth/refresh renouvelle le jeton (rotation).
end note
@enduml
